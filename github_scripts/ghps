#!/bin/bash

# Проверка, находимся ли мы в git репозитории
if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    echo "Ошибка: Текущая директория не является git репозиторием."
    exit 1
fi

# Проверка наличия изменений (включая неотслеживаемые файлы)
if [ -z "$(git status --porcelain)" ]; then
    echo "Нет изменений для коммита и отправки (push). Репозиторий чист."
    exit 0
fi

echo "Найдены изменения. Добавляем и коммитим..."

# Добавляем все изменения (включая новые файлы)
git add -A

# Выполняем коммит с заданным сообщением
git commit -m "Auto commit from ai script"

echo "Отправляем изменения в удаленный репозиторий..."
# Выполняем push
git push

echo "Успешно отправлено!"
